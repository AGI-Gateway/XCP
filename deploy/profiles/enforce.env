# XCP deployment profile: enforce
#
# A production single-site node. The full decision path: mandates gate scopes, the argument firewall inspects tool arguments, and abuse controls are on. No federation.
#
# Generated by scripts/generate-config-profiles.py from
# ops/profiles.py. Do not edit: a hand-edited profile is a
# profile that has drifted from the settings registry.

# enforce | observe. Observe logs decisions without blocking them — for onboarding an endpoint you have not vetted, never a steady state.  [WEAKENS A CONTROL]
XCP_POSTURE=enforce

# Enable the xcpsec argument firewall. The gateway REFUSES TO START if this is 1 and xcpsec is unavailable, rather than running with a control you asked for silently absent.
XCP_SECURITY=1

# Abuse controls. Setting 0 on a node reachable by strangers makes it an open relay.  [WEAKENS A CONTROL]
XCP_RATE_LIMIT=1

# Serve traffic if the limiter itself fails. Turns any limiter bug into an abuse bypass; only for private deployments behind another limiter.  [WEAKENS A CONTROL]
XCP_LIMIT_FAIL_OPEN=0

# development | production. The production profile refuses to start unless enforce posture, an external verifier, hardening, rate limiting, an admin token and secure peering are all in place — a profile that is claimed and not enforced is worse than one never claimed.
XCP_PROFILE=production

# Refuse calls that did not arrive through a gateway. Setting 0 lets anyone reach the tools directly, bypassing every control.  [WEAKENS A CONTROL]
REQUIRE_VERIFIED=1

# Accept a throwaway sealing key. Every restart invalidates every sealed credential; local testing only.  [WEAKENS A CONTROL]
XCP_SEAL_EPHEMERAL=0

# scrubbed | hosts | full. `full` exports raw agent ids, scopes and hostnames — self-hosted collectors only. Sending it to a vendor is a new processor and usually an international transfer.  [WEAKENS A CONTROL]
XCP_OTEL_DETAIL=scrubbed

# --------------------------------------------------------------------
# YOU MUST SUPPLY THESE. Empty here on purpose.
# --------------------------------------------------------------------

# JSON map of name to MCP url, e.g. {"research":"https://.../mcp"}. Empty means every a2t call 404s.
#   JSON map of server name to MCP URL, e.g. {"research":"https://mcp.internal/mcp"}
XCP_UPSTREAMS=

# External verifier. Unset uses in-memory bindings, which is fine for one node and insufficient for a federation.
#   URL of your verifier, e.g. http://verifier:8500
XCP_VERIFY_URL=

# Bearer token for /admin/* and the full peer list. When unset the administrative endpoints are DISABLED rather than open — an admin surface that defaults to open is worse than one that does not exist. Compared in constant time.
#   required to reach /admin/revoke. Keep it in a secret backend, never in this file or an image.
XCP_ADMIN_TOKEN=
