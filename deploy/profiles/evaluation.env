# XCP deployment profile: evaluation
#
# A single node for trying XCP against endpoints you have not vetted. Audits every decision and blocks none, so you can see what enforcement WOULD do before it does it. Not a steady state: a node left here refuses nothing.
#
# Generated by scripts/generate-config-profiles.py from
# ops/profiles.py. Do not edit: a hand-edited profile is a
# profile that has drifted from the settings registry.

# --------------------------------------------------------------------
# THIS PROFILE DELIBERATELY WEAKENS CONTROLS
# --------------------------------------------------------------------
#   XCP_POSTURE: observe is the entire point of this profile -- it logs the decision a mandate gate would have made without making it. Every node running this profile is an open relay with a very good audit trail.

# enforce | observe. Observe logs decisions without blocking them — for onboarding an endpoint you have not vetted, never a steady state.  [WEAKENS A CONTROL]
XCP_POSTURE=observe

# What vouches for an agent when a session opens: none | mtls | oidc | chain. Each justifies a different maximum agent tier — none A0 (self-asserted, development only), mtls and oidc A1 (your own CA or IdP issued it), chain A2 (a registry a peer who does not trust you can check). Empty infers chain when XCP_VERIFY_URL is set and none otherwise. The production profile refuses 'none'.
XCP_REGISTRAR=none

# Enable the xcpsec argument firewall. The gateway REFUSES TO START if this is 1 and xcpsec is unavailable, rather than running with a control you asked for silently absent.
XCP_SECURITY=0

# Abuse controls. Setting 0 on a node reachable by strangers makes it an open relay.  [WEAKENS A CONTROL]
XCP_RATE_LIMIT=1

# Identifier stamped on audit records and forwarded downstream as XCP-Verified-By.
XCP_GATEWAY_ID=gw-eval
