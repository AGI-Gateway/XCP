# XCP deployment profile: private-federation
#
# Independent nodes across datacentres in one trust domain. Adds declared peer ranges, an internal CA that REPLACES the public trust store, a signed cluster charter, and site locality with data residency.
#
# Generated by scripts/generate-config-profiles.py from
# ops/profiles.py. Do not edit: a hand-edited profile is a
# profile that has drifted from the settings registry.

# enforce | observe. Observe logs decisions without blocking them — for onboarding an endpoint you have not vetted, never a steady state.  [WEAKENS A CONTROL]
XCP_POSTURE=enforce

# Enable the xcpsec argument firewall. The gateway REFUSES TO START if this is 1 and xcpsec is unavailable, rather than running with a control you asked for silently absent.
XCP_SECURITY=1

# Abuse controls. Setting 0 on a node reachable by strangers makes it an open relay.  [WEAKENS A CONTROL]
XCP_RATE_LIMIT=1

# Serve traffic if the limiter itself fails. Turns any limiter bug into an abuse bypass; only for private deployments behind another limiter.  [WEAKENS A CONTROL]
XCP_LIMIT_FAIL_OPEN=0

# development | production. The production profile refuses to start unless enforce posture, an external verifier, hardening, rate limiting, an admin token and secure peering are all in place — a profile that is claimed and not enforced is worse than one never claimed.
XCP_PROFILE=production

# Accept delegated tasks from peer gateways at /v1/a2a/accept. OFF by default: a node that accepts them is executing work on another datacentre's say-so, which an operator should decide deliberately rather than inherit from an upgrade. A ticket is still only admitted from a verified peer, in this node's cluster, naming this node, within its expiry, for the exact task committed to.
XCP_A2A_ACCEPT=1

# How many boundaries one delegation may cross. Matches the federation's transitive-trust cap, for the same reason: beyond it nobody in the chain can reason about what they are part of. The originator sets the budget in the ticket and no hop can raise it.
XCP_A2A_MAX_HOPS=3

# Serve tool calls on a peer's behalf at /v1/tool/relay. OFF by default: relaying spends THIS node's vendor credential on another datacentre's say-so. A relayed call is admitted exactly as a cross-boundary delegation is — verified peer, this node's cluster, naming this node, within expiry, for the exact call committed to — and runs at the tier narrowed under this node's ceiling. Enabling it also advertises this node's upstream server names to peers.
XCP_TOOL_RELAY=1

# Ask a peer for a tool this node cannot reach. OFF by default: a call leaving for another datacentre is a different data path than the one configured in XCP_UPSTREAMS, and the operator should choose it. With it on, an unknown server is routed to a peer that advertises it, preferring the nearest site and refusing any site XCP_RESIDENCY_SITES does not permit.
XCP_TOOL_FALLBACK=0

# Serve the FULL node record to anyone, even in a closed cluster. A closed cluster gates its record by default — publishing the topology of a federation only members may join is incoherent, and gating also means a removed member loses discovery and not just peering. Set this for a node that must stay publicly discoverable: a public-facing gateway inside a private organisation, or one under external monitoring. It publishes this node's id, gateway URL, operator and seed peers.  [WEAKENS A CONTROL]
XCP_NODE_RECORD_PUBLIC=0

# Refuse calls that did not arrive through a gateway. Setting 0 lets anyone reach the tools directly, bypassing every control.  [WEAKENS A CONTROL]
REQUIRE_VERIFIED=1

# Accept a throwaway sealing key. Every restart invalidates every sealed credential; local testing only.  [WEAKENS A CONTROL]
XCP_SEAL_EPHEMERAL=0

# scrubbed | hosts | full. `full` exports raw agent ids, scopes and hostnames — self-hosted collectors only. Sending it to a vendor is a new processor and usually an international transfer.  [WEAKENS A CONTROL]
XCP_OTEL_DETAIL=scrubbed

# Override the maximum agent tier this node's registrar justifies, e.g. A2. Raising it above the registrar's default is permitted and PUBLISHED in the node record, because a node asserting A2 on the strength of its own CA is making a claim its peers are entitled to discount. Lowering it needs no announcement.  [WEAKENS A CONTROL]
XCP_REGISTRAR_CEILING=

# --------------------------------------------------------------------
# YOU MUST SUPPLY THESE. Empty here on purpose.
# --------------------------------------------------------------------

# What vouches for an agent when a session opens: none | mtls | oidc | chain. Each justifies a different maximum agent tier — none A0 (self-asserted, development only), mtls and oidc A1 (your own CA or IdP issued it), chain A2 (a registry a peer who does not trust you can check). Empty infers chain when XCP_VERIFY_URL is set and none otherwise. The production profile refuses 'none'.
#   what vouches for an agent: mtls, oidc or chain. Across a federation this matters more than on a single node — a peer reads it from your node record and prices your attestations accordingly. mtls and oidc are your own say-so and cap at A1; only a registry a peer can check independently justifies A2.
XCP_REGISTRAR=

# Comma-separated internal ranges that may hold federation peers, e.g. "10.40.0.0/16,fd00:dc1::/48". Without this a peer on a private address is unreachable, which made a private federation across datacentres impossible to run under the production profile. Narrower than XCP_ALLOW_INSECURE_PEERS in two ways: a host that resolves outside every declared range is still refused, and loopback, link-local and cloud-metadata addresses stay refused even when a declaration contains them. TLS is still required. Declarations broader than /8 (IPv4) or /7 (IPv6) are refused as a disguised bypass, and a malformed entry stops the node starting rather than silently narrowing what you declared.
#   comma-separated internal ranges that may hold peers, e.g. 10.20.0.0/16,10.30.0.0/16. Narrower than allowing all private space; an undeclared range is still refused, and no declaration can re-admit link-local or cloud metadata.
XCP_PRIVATE_PEER_CIDRS=

# PEM bundle of the certificate authorities that sign THIS federation's peers. When set it REPLACES the public trust store for peer-record fetches and certificate-footprint retrieval — and for those only, so upstream tool calls keep public trust. Needed for a private federation using an internal CA: chain validation ran against the system store and failed before the footprint binding was reached. A mixed deployment concatenates the public roots it needs into the same file, which keeps the trust decision in one auditable place. An unreadable or empty bundle stops the node starting; falling back to the public store would leave the operator believing peers are verified against their own CA.
#   path to your internal CA. This REPLACES the public trust store for peer connections rather than adding to it -- that is the point, and it is why peering still refuses plain HTTP.
XCP_PEER_CA_BUNDLE=

# Path to the signed cluster charter this node federates under. The charter commits to the member set with a Merkle root and carries no roster, so it can be distributed to every node without publishing who is in the cluster. A closed cluster refuses any peer whose membership proof does not verify against THIS charter's root — never against one the peer supplied. Unset means no cluster, and peering is bilateral. A charter that does not verify stops the node: starting without it would leave a closed cluster accepting any peer, which is what it exists to prevent.
#   path to the signed charter for this cluster
XCP_CLUSTER_CHARTER=

# Path to THIS node's own membership proof, issued by the cluster authority. Published in the node record so peers can verify this node against their own charter. The node refuses to start if the proof does not verify, or if it is a proof for a different node — which catches a membership file copied from another datacentre.
#   path to this node's membership claim
XCP_CLUSTER_MEMBERSHIP=

# This node's datacentre, region or zone — an opaque label you choose, e.g. 'dc1-dublin' or 'eu-west-1'. Peers prefer local routes over crossing a site boundary and apply their own residency rules against it. Unset means this node has no locality, so every peer is equally near and nothing is preferred. Published in the node record (a peer cannot observe it) and withheld from the reduced one.
#   this node's site, e.g. eu-west. A peer elsewhere is priced at CROSS_SITE_COST and can still win on cost.
XCP_NODE_SITE=

# Comma-separated sites where a relayed tool call's data may be processed, e.g. 'eu-west-1,eu-central-1'. When set, a peer outside is INADMISSIBLE rather than merely expensive — a jurisdiction is not a quantity you can be compensated for crossing. A peer that declares no site fails this: not knowing where a peer is is not the same as it being somewhere permitted. Empty means no residency constraint.
#   sites data may reach. Unlike locality this is a CONSTRAINT: a site outside this set is inadmissible at any price.
XCP_RESIDENCY_SITES=

# JSON map of name to MCP url, e.g. {"research":"https://.../mcp"}. Empty means every a2t call 404s.
#   JSON map of server name to MCP URL
XCP_UPSTREAMS=

# External verifier. Unset uses in-memory bindings, which is fine for one node and insufficient for a federation.
#   URL of your verifier
XCP_VERIFY_URL=

# Bearer token for /admin/* and the full peer list. When unset the administrative endpoints are DISABLED rather than open — an admin surface that defaults to open is worse than one that does not exist. Compared in constant time.
#   keep it in a secret backend
XCP_ADMIN_TOKEN=
