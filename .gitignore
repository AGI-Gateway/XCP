dist/
# `python -m build` writes here now that the project has a pyproject.toml.
# Committing it would ship a second, stale copy of every package -- which also
# breaks repo-wide greps, since build/lib/ mirrors the whole source tree.
build/
node_modules/
paper/*.pdf
secrets.yaml
secrets.yml
site/
vault/**/*.secret
vault/local/
venv/
xcp.toml.local

# Machine-specific timings; bench/RESULTS.md carries the narrative.
bench/engine-results.json
